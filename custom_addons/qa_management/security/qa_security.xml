<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <record id="module_category_qa_management" model="ir.module.category">
            <field name="name">QA Management</field>
            <field name="description">Helps you manage your QA testing lifecycle.</field>
            <field name="sequence">10</field>
        </record>

        <!-- Roles -->
        <record id="group_qa_tester" model="res.groups">
            <field name="name">QA Tester</field>
        </record>

        <record id="group_qa_senior_tester" model="res.groups">
            <field name="name">Senior QA Tester</field>
            <field name="implied_ids" eval="[(4, ref('group_qa_tester'))]"/>
        </record>

        <record id="group_qa_lead" model="res.groups">
            <field name="name">QA Lead</field>
            <field name="implied_ids" eval="[(4, ref('group_qa_senior_tester'))]"/>
        </record>

        <record id="group_qa_developer" model="res.groups">
            <field name="name">Developer</field>
        </record>

        <record id="group_qa_pm" model="res.groups">
            <field name="name">Project Manager</field>
        </record>

        <record id="group_qa_management" model="res.groups">
            <field name="name">Management</field>
        </record>

        <record id="group_qa_client" model="res.groups">
            <field name="name">Client / UAT User</field>
        </record>

    </data>
</odoo>
