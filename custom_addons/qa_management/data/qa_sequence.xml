<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Test Case ID -->
        <record id="seq_qa_test_case" model="ir.sequence">
            <field name="name">QA Test Case Sequence</field>
            <field name="code">qa.test.case.seq</field>
            <field name="prefix"></field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Bug ID -->
        <record id="seq_qa_bug" model="ir.sequence">
            <field name="name">QA Bug Sequence</field>
            <field name="code">qa.bug.seq</field>
            <field name="prefix"></field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
